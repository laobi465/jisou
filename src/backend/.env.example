# ===== 应用配置 =====
APP_ENV = production
APP_DEBUG = false
APP_URL = <在此填写站点域名>

# ===== 数据库 =====
DB_TYPE = mysql
DB_HOST = <在此填写数据库主机>
DB_PORT = 3306
DB_NAME = <在此填写数据库名>
DB_USER = <在此填写数据库用户名>
DB_PASS = <在此填写数据库密码>
DB_CHARSET = utf8mb4
DB_PREFIX = jisou_

# ===== Redis =====
REDIS_HOST = <在此填写 Redis 主机>
REDIS_PORT = 6379
REDIS_PASSWORD = <在此填写 Redis 密码>

# ===== Meilisearch =====
MEILISEARCH_HOST = <在此填写 Meilisearch 地址>
MEILISEARCH_KEY = <在此填写 Meilisearch 主密钥>

# ===== JWT 鉴权 =====
JWT_SECRET = <在此填写 JWT 密钥>
JWT_ACCESS_TTL = 7200
JWT_REFRESH_TTL = 604800

# ===== Telegram 爬虫（如启用 TG 来源）=====
TG_API_ID = <在此填写 Telegram API ID>
TG_API_HASH = <在此填写 Telegram API Hash>
TG_SESSION = <在此填写 Telegram Session 字符串>

# ===== 邮件 =====
MAIL_HOST = <在此填写 SMTP 主机>
MAIL_PORT = 587
MAIL_USERNAME = <在此填写 SMTP 用户名>
MAIL_PASSWORD = <在此填写 SMTP 密码>
MAIL_FROM_ADDRESS = <在此填写发件邮箱>
MAIL_FROM_NAME = jisou

# ===== 限流 =====
RATE_LIMIT_SEARCH = 60
RATE_LIMIT_LOGIN = 5

# ===== 解析模块总开关 =====
PARSE_MODULE_ENABLED = false

# ===== 默认语言 =====
DEFAULT_LANG = zh-cn
